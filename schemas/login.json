{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "definitions": {
        "login": {
            "id": "/login",
            "title": "Login",
            "description": "login route",
            "type": "object",
            "properties": {
                "username": {
                    "description": "username",
                    "type": "string"
                },
                "password": {
                    "description": "password",
                    "type": "string"
                }
            },
            "required": ["username", "password"],
            "additionalProperties": false
        },
        "loggedIn": {
            "id": "/loggedIn",
            "title": "Login Success",
            "description": "Confirmation of login",
            "type": "object",
            "properties": {
                "id": {
                    "description": "user id",
                    "type": "string"
                },
                "username": {
                    "description": "username",
                    "type": "string"
                },
                "email": {
                    "description": "email",
                    "type": "string"
                },
                "role": {
                    "description": "user role",
                    "type": "string"
                },
                "token": {
                    "description": "jwt token",
                    "type": "string"
                },
                "links": {
                    "description": "links",
                    "type": "object",
                    "properties": {
                        "self": {
                            "description": "self",
                            "type": "string"
                        }
                    },
                    "required": ["self"],
                    "additionalProperties": false
                }
            }            
        }
    }
}