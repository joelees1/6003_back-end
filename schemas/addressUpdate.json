{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "id": "/address/[id]",
    "title": "Address Update",
    "description": "A user updating their address",
    "type": "object",
    "properties": {
        "address_line1": {
            "type": "string",
            "minLength": 3
        },
        "address_line2": {
            "type": "string",
            "minLength": 3
        },
        "city": {
            "type": "string",
            "minLength": 2
        },
        "postcode": {
            "type": "string",
            "minLength": 1
        },
        "country": {
            "type": "string",
            "minLength": 1
        }
    },
    "additionalProperties": false
}