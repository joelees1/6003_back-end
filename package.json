  "description": "6003CEM coursework backend",
  "main": "index.js",
  "scripts": {
    "test": "cross-env DB_DATABASE=6003_CW_tests jest --testTimeout=10000 --detectOpenHandles",
    "test:watch": "cross-env DB_DATABASE=6003_CW_tests jest --watch",
    "6003_CW_tests:drop": "mysql --user=root --password=Musicrox79* -e 'DROP DATABASE 6003_CW_tests;'",
    "6003_CW_tests:create": "mysql --user=root --password=Musicrox79* -e 'CREATE DATABASE 6003_CW_tests;'",
    "6003_CW_tests:migrate": "mysqldump --user=root --password=Musicrox79* 6003_CW | mysql --user=root --password=Musicrox79* 6003_CW_tests",
    "pretest": "npm run 6003_CW_tests:drop && npm run 6003_CW_tests:create && npm run 6003_CW_tests:migrate"
  },
  "repository": {
    "type": "git",
    "url": "https://github.coventry.ac.uk/leesj4/6003CEM_leesj4_Back-end"
  },
  "author": "Joseph Lees",
  "license": "ISC",
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "ajv": "^8.12.0",
    "bcrypt": "^5.1.1",
    "fs": "^0.0.1-security",
    "jsonschema": "^1.4.1",
    "koa": "^2.15.0",
    "koa-body": "^4.2.0",
    "koa-bodyparser": "^4.4.1",
    "koa-passport": "^6.0.0",
    "koa-router": "^12.0.1",
    "mime-types": "^2.1.35",
    "moment": "^2.30.1",
    "mysql2": "^3.9.1",
    "passport-jwt": "^4.0.1",
    "redoc": "^2.1.3",
    "role-acl": "^4.5.4",
